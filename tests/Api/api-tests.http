###############################################
# Combined Schedules - Complete Flow Test
###############################################

### 85. Complete Flow: Create Personal + Class Schedules → View Combined
# Step 1: Create Personal Schedule
# @name createPersonalSchedule
POST {{baseUrl}}/api/personal-schedules
Content-Type: {{contentType}}
Authorization: Bearer {{schedulesToken}}

{
  "title": "Personal Study Session",
  "start_time": "2025-11-20 10:00:00",
  "end_time": "2025-11-20 12:00:00",
  "location": "Library",
  "description": "Study for exam",
  "color": "#10B981"
}

### Step 2: Create Classroom (if not exists)
# @name createClassroomForFlow
POST {{baseUrl}}/api/classrooms
Content-Type: {{contentType}}
Authorization: Bearer {{schedulesToken}}

{
  "name": "Test Classroom for Schedules",
  "description": "Testing combined schedules"
}

@flowClassroomId = {{createClassroomForFlow.response.body.data.id}}

### Step 3: Create Class Schedule
POST {{baseUrl}}/api/classrooms/{{flowClassroomId}}/schedules
Content-Type: {{contentType}}
Authorization: Bearer {{schedulesToken}}

{
  "title": "Class Lecture",
  "start_time": "2025-11-20 14:00:00",
  "end_time": "2025-11-20 16:00:00",
  "location": "Room 301",
  "lecturer": "Dr. Smith",
  "description": "Weekly lecture",
  "color": "#5CD9C1"
}

### Step 4: View All Combined Schedules
GET {{baseUrl}}/api/schedules
Accept: {{contentType}}
Authorization: Bearer {{schedulesToken}}

# Should see both personal and class schedules

### Step 5: Filter by Personal
GET {{baseUrl}}/api/schedules?source=personal
Accept: {{contentType}}
Authorization: Bearer {{schedulesToken}}

# Should only see personal schedule

### Step 6: Filter by Classroom
GET {{baseUrl}}/api/schedules?source=classroom:{{flowClassroomId}}
Accept: {{contentType}}
Authorization: Bearer {{schedulesToken}}

# Should only see class schedule

