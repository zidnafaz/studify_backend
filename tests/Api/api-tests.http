###############################################
# Classroom Management - Complete Flow Test
###############################################

### 67. Complete Flow: Create → Join → View → Update → Leave → Delete
# Step 1: Create Classroom
# @name flowCreateClassroom
POST {{baseUrl}}/api/classrooms
Content-Type: {{contentType}}
Authorization: Bearer {{ownerToken}}

{
  "name": "Flow Test Classroom",
  "description": "Testing complete flow"
}

@flowClassroomId = {{flowCreateClassroom.response.body.data.id}}
@flowUniqueCode = {{flowCreateClassroom.response.body.data.unique_code}}

### Step 2: Get Classroom Detail
GET {{baseUrl}}/api/classrooms/{{flowClassroomId}}
Accept: {{contentType}}
Authorization: Bearer {{ownerToken}}

### Step 3: Member Joins Classroom
POST {{baseUrl}}/api/classrooms/join
Content-Type: {{contentType}}
Authorization: Bearer {{memberToken}}

{
  "unique_code": "{{flowUniqueCode}}"
}

### Step 4: Member Views Classroom
GET {{baseUrl}}/api/classrooms/{{flowClassroomId}}
Accept: {{contentType}}
Authorization: Bearer {{memberToken}}

### Step 5: Owner Updates Classroom
PUT {{baseUrl}}/api/classrooms/{{flowClassroomId}}
Content-Type: {{contentType}}
Authorization: Bearer {{ownerToken}}

{
  "name": "Flow Test Classroom - Updated",
  "description": "Updated description"
}

### Step 6: Member Leaves Classroom
POST {{baseUrl}}/api/classrooms/{{flowClassroomId}}/leave
Content-Type: {{contentType}}
Authorization: Bearer {{memberToken}}

### Step 7: Owner Deletes Classroom
DELETE {{baseUrl}}/api/classrooms/{{flowClassroomId}}
Authorization: Bearer {{ownerToken}}

### Step 8: Try to Access Deleted Classroom (Should Fail)
GET {{baseUrl}}/api/classrooms/{{flowClassroomId}}
Accept: {{contentType}}
Authorization: Bearer {{ownerToken}}

